# Single Source of Truth for All Configuration
# Copy this file to .env and modify as needed

# Service Configuration
SCHEME=http
CLASSIFIER_HOST=0.0.0.0
CLASSIFIER_PORT=8000
MODEL_PIPELINE_MANAGER_HOST=0.0.0.0
MODEL_PIPELINE_MANAGER_PORT=8001

# Service URLs are built based on scheme, host and port (for inter-service communication)
# No need to specify URLs manually - they are constructed in config/general.py

# For Docker Compose, override hosts in infrastructure/docker/docker-compose.yml:
# CLASSIFIER_HOST=classifier
# MODEL_PIPELINE_MANAGER_HOST=model-pipeline-manager

# Model Configuration
TEST_SIZE=0.3
RANDOM_STATE=42
LAPLACE_SMOOTHING=1.0

# Cache Configuration
MODEL_CACHE_CAPACITY=3

# Data Configuration
CSV_ENCODING=utf-8